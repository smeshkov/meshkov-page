{
    "name": "meshkov-page",
    "version": "0.0.1",
    "description": "Meshkov Page",
    "main": "src/index.js",
    "scripts": {
        "start": "NODE_ENV=development webpack-dev-server --mode development --port 8081 --host 0.0.0.0",
        "start:stg": "NODE_ENV=staging webpack-dev-server --mode development --port 8081 --host 0.0.0.0",
        "test": "echo \"Error: no test specified\" && exit 1",
        "typecheck": "tsc --noEmit --skipLibCheck",
        "lint": "npm run typecheck && npx eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "npx eslint . --ext .js,.jsx,.ts,.tsx --fix",
        "prettier": "prettier --check 'src/**/*.ts' 'src/**/*.tsx'",
        "prettier:fix": "prettier --write 'src/**/*.ts' 'src/**/*.tsx'",
        "build": "NODE_ENV=production webpack --mode production",
        "build:stg": "NODE_ENV=staging webpack --mode production",
        "build:dev": "NODE_ENV=development webpack --mode development",
        "clean": "rm -rf dist/*",
        "deploy": "gsutil -m rsync -R dist gs://www.meshkov.page",
        "deploy:stg": "gsutil -m rsync -R dist gs://meshkov.zoomio.org",
        "tag": "git tag v$(npm -s run env echo '$npm_package_version') && git push origin v$(npm -s run env echo '$npm_package_version')",
        "release": "git tag release-v$(npm -s run env echo '$npm_package_version') && git push origin release-v$(npm -s run env echo '$npm_package_version')"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mindi-ai/mindi-ui.git"
    },
    "author": "Sergey Meshkov",
    "license": "ISC",
    "devDependencies": {
        "@babel/cli": "^7.12.17",
        "@babel/core": "^7.12.17",
        "@babel/plugin-proposal-class-properties": "^7.12.13",
        "@babel/plugin-transform-runtime": "^7.12.17",
        "@babel/preset-env": "^7.12.17",
        "@babel/preset-react": "^7.12.13",
        "@babel/preset-typescript": "^7.12.17",
        "@svgr/webpack": "^6.2.1",
        "@types/chrome": "0.0.132",
        "@types/color": "^3.0.1",
        "@types/react": "^17.0.2",
        "@types/react-router-dom": "^5.1.7",
        "@types/styled-components": "^5.1.7",
        "@typescript-eslint/eslint-plugin": "^4.22.0",
        "@typescript-eslint/parser": "^4.22.0",
        "babel-loader": "^8.2.2",
        "clean-webpack-plugin": "^3.0.0",
        "color": "^3.1.3",
        "copy-webpack-plugin": "^6.4.1",
        "css-loader": "^5.0.2",
        "eslint": "^7.24.0",
        "eslint-config-prettier": "^8.2.0",
        "file-loader": "^6.2.0",
        "html-loader": "^1.3.2",
        "html-webpack-plugin": "^4.5.1",
        "mini-css-extract-plugin": "^1.3.7",
        "prettier": "2.2.1",
        "svg-url-loader": "^7.1.1",
        "ts-loader": "^8.0.17",
        "typescript": "^4.2.4",
        "webpack": "^5.68.0",
        "webpack-cli": "^4.9.2",
        "webpack-dev-server": "^4.7.4"
    },
    "optionalDependencies": {
        "fsevents": "*"
    },
    "dependencies": {
        "@babel/runtime": "^7.12.18",
        "date-fns": "^2.29.1",
        "html-react-parser": "^3.0.1",
        "prop-types": "^15.7.2",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-icons": "^4.2.0",
        "react-is": "^17.0.2",
        "react-router-dom": "^5.2.0",
        "styled-components": "^5.2.3"
    }
}
